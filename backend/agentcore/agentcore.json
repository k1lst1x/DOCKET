{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "docket",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "docket"
  },
  "runtimes": [
    {
      "name": "docket_chat",
      "description": "Resident chat agent for Fremont. Read-only tools over city records, Docket data, live feeds, news, places and the web; cited answers.",
      "build": "CodeZip",
      "entrypoint": "agentcore_chat.py",
      "codeLocation": "./",
      "runtimeVersion": "PYTHON_3_11",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "instrumentation": { "enableOtel": true },
      "envVars": [
        { "name": "BEDROCK_MODEL_ID", "value": "openai.gpt-oss-120b-1:0" },
        { "name": "EMBED_MODEL_ID", "value": "amazon.titan-embed-text-v2:0" },
        { "name": "DSQL_ENDPOINT", "value": "arucmxa62xrerk4vt7b2kveetu.dsql.us-west-2.on.aws" },
        { "name": "S3_VECTORS_BUCKET", "value": "docket-vectors-465083445156" },
        { "name": "S3_VECTORS_INDEX", "value": "docket-chunks" },
        { "name": "FIRECRAWL_SECRET_ID", "value": "docket/firecrawl" },
        { "name": "GOOGLE_PLACES_SECRET_ID", "value": "docket/google-places" },
        { "name": "PYTHONUTF8", "value": "1" },
        { "name": "BEDROCK_ROLE_ARN", "value": "arn:aws:iam::576884310211:role/DocketBedrockAccess" },
        { "name": "BEDROCK_EXTERNAL_ID", "value": "docket-bedrock-465083445156" }
      ],
      "additionalPolicies": ["agentcore/policies/docket-chat.json"]
    },
    {
      "name": "docket_pipeline",
      "description": "Fremont ingestion and generation pipeline: crawl, extract, chunk, embed and store; verified outputs.",
      "build": "CodeZip",
      "entrypoint": "agentcore_pipeline.py",
      "codeLocation": "./",
      "runtimeVersion": "PYTHON_3_11",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "instrumentation": { "enableOtel": true },
      "envVars": [
        { "name": "BEDROCK_MODEL_ID", "value": "openai.gpt-oss-120b-1:0" },
        { "name": "EMBED_MODEL_ID", "value": "amazon.titan-embed-text-v2:0" },
        { "name": "DSQL_ENDPOINT", "value": "arucmxa62xrerk4vt7b2kveetu.dsql.us-west-2.on.aws" },
        { "name": "S3_BUCKET", "value": "docket-raw-465083445156-us-west-2" },
        { "name": "S3_VECTORS_BUCKET", "value": "docket-vectors-465083445156" },
        { "name": "S3_VECTORS_INDEX", "value": "docket-chunks" },
        { "name": "FIRECRAWL_SECRET_ID", "value": "docket/firecrawl" },
        { "name": "PYTHONUTF8", "value": "1" },
        { "name": "BEDROCK_ROLE_ARN", "value": "arn:aws:iam::576884310211:role/DocketBedrockAccess" },
        { "name": "BEDROCK_EXTERNAL_ID", "value": "docket-bedrock-465083445156" }
      ],
      "additionalPolicies": ["agentcore/policies/docket-pipeline.json"]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
