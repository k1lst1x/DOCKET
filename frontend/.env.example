# Server-only configuration. Copy to .env.local for development;
# scripts/aws-provision.sh writes the AWS IDs below into .env.local for you.
# In Amplify, set these as environment variables; amplify.yml copies them into
# .env.production so the Next.js server can read them at runtime.
# (Amplify reserves the AWS_ prefix, so nothing here needs AWS_REGION: the region
# comes from the DSQL endpoint and the Cognito pool ID.)

# 1 shows the "sign in as" account switcher in the header.
DEMO=1

# Signs the app's session cookies. Use 32+ random bytes in production.
SESSION_SECRET=replace-with-a-long-random-string

# Absolute origin of the site.
APP_URL=http://localhost:3000

# Aurora DSQL cluster endpoint and database role. Locally the app connects with
# your AWS CLI login (aws login); on Amplify with the SSR compute role.
DSQL_ENDPOINT=
DSQL_USER=admin

# Cognito user pool (Essentials tier, email one-time codes) and its app client.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# FastAPI backend, called from Next.js server code only.
API_BASE_URL=http://localhost:8000/api/v1
