# Server-only configuration. Copy to .env.local for development;
# scripts/aws-provision.sh writes the AWS IDs below into .env.local for you.
# In Amplify, set these as environment variables; amplify.yml copies them into
# .env.production so the Next.js server can read them at runtime.
# (Amplify reserves the AWS_ prefix, so nothing here needs AWS_REGION: the region
# comes from the DSQL endpoint.)

# 1 shows the "sign in as" account switcher in the header.
DEMO=1

# Signs the app's session cookies. Use 32+ random bytes in production.
SESSION_SECRET=replace-with-a-long-random-string

# Absolute origin of the site.
APP_URL=http://localhost:3000

# Aurora DSQL cluster endpoint and database role. Locally the app connects with
# your AWS CLI login (aws login); on Amplify with the SSR compute role.
DSQL_ENDPOINT=
DSQL_USER=admin

# Private S3 bucket for photos and videos in home feed posts (scripts/aws-media-bucket.sh creates it
# and writes this). On Amplify, the SSR compute role needs s3:PutObject, s3:GetObject and
# s3:PutObjectTagging on <bucket>/uploads/*. Without it, posts are text only.
# Photos and videos go through an automatic content check (Amazon Rekognition): the same role also needs
# rekognition:DetectModerationLabels, DetectText, StartContentModeration and GetContentModeration
# (scripts/aws-media-moderation.sh grants them to the local dev user).
DOCKET_MEDIA_BUCKET=

# Docket chat agent: ARN of the deployed AgentCore runtime docket_chat (takes priority when set).
DOCKET_CHAT_RUNTIME_ARN=
# Local fallback when no ARN is set: the backend/ FastAPI chat endpoint; only localhost URLs are used.
DOCKET_CHAT_URL=

# Places page (browser-side, so the key ships to visitors: restrict it by HTTP referrer to your
# domains and to Maps JavaScript API + Places API (New) in Google Cloud). Read at build time.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for advanced markers (Google Cloud > Map management). DEMO_MAP_ID is used when empty.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
