# Copy to docket/.env (gitignored) and fill in.
# AWS keys can be left blank if the AWS CLI is configured (aws configure / aws sso login).
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials:
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2

# openai.gpt-oss-120b runs on-demand. Target is us.openai.gpt-5.6-luna once the account has access.
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Aurora DSQL cluster endpoint (IAM auth, no password), e.g. <id>.dsql.us-west-2.on.aws
DSQL_ENDPOINT=
# Amazon S3 Vectors: vector bucket and index (1024 dims, cosine)
S3_VECTORS_BUCKET=
S3_VECTORS_INDEX=docket-chunks
# S3 bucket for raw scraped HTML/PDF originals
S3_BUCKET=

# Firecrawl API key (firecrawl.dev dashboard), used for fremont.gov and FUSD pages.
FIRECRAWL_API_KEY=

# 1 = run everything in-process without AgentCore
LOCAL=1
