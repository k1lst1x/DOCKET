# Copy to docket/.env (gitignored) and fill in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials:
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2

# Override if your account requires a cross-region inference profile ID.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# RDS PostgreSQL with pgvector, e.g. postgresql://user:pass@host:5432/docket
DATABASE_URL=
S3_BUCKET=

# 1 = run everything in-process without AgentCore
LOCAL=1
